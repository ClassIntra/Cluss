# 依赖
node_modules/

# 环境变量（含密钥，绝不入库）
.env
.env.*
!.env.example

# 数据库
server/database/
*.db
*.db-shm
*.db-wal

# 日志与运行时产物
server/logs/
client/dist/
*.log

# 云盘文件（用户上传的内容，体积大且属于运行时数据）
server/Resources/

# 测试脚手架（含走查截图与探针脚本，属临时产物不入库）
.tmp-qa/
.qa-auto/

# 临时排查脚本（一次性用，用完即删）
server/scripts/_tmp-*.js

# 渲染探针页（手工打开量性能用的临时页面）
client/bench-render.html
client/render-probe.html
client/public/orient-probe.html

# 编辑器
.vscode/
.idea/
.DS_Store
# 工具产物（安全扫描 / 会话工具）
.mimosa/
client/.mimosa/
.workbuddy/

# 云机数据备份（真实账目，禁止入库）
backups/

# 部署打包产物（src/dist 快照，属跨机传输用临时件，禁止入库）
*.tgz

# 会话计划与草稿（内部工作记录，属本地产物）
.zcode/

# 随手粘贴的 .txt：极易混进密钥（env 片段、token、连接串），一律不入库
*.txt

# shared/ 是源码不是运行数据：student-prefs.json 被前端 import、服务端 require，
# 是「档位与科目白名单」的单一真源。曾整条忽略过，结果从 git 检出部署的人
# 前端构建直接失败、服务端 MODULE_NOT_FOUND 起不来（本机 tgz 部署发现不了）。
# 没有任何代码写这个目录，全部入库。
