# 依赖
node_modules/

# 环境变量（含密钥，绝不入库）
.env
.env.*
!.env.example

# 数据库
server/database/
*.db
*.db-shm
*.db-wal

# 日志与运行时产物
server/logs/
client/dist/
*.log

# 云盘文件（用户上传的内容，体积大且属于运行时数据）
server/Resources/

# 测试脚手架（含走查截图与探针脚本，属临时产物不入库）
.tmp-qa/
.qa-auto/

# 临时排查脚本（一次性用，用完即删）
server/scripts/_tmp-*.js

# 渲染探针页（手工打开量性能用的临时页面）
client/bench-render.html
client/render-probe.html
client/public/orient-probe.html

# 编辑器
.vscode/
.idea/
.DS_Store
# 工具产物（安全扫描 / 会话工具）
.mimosa/
client/.mimosa/
.workbuddy/

# 云机数据备份（真实账目，禁止入库）
backups/
