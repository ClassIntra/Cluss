# ============================================================
# Cluss 服务端配置模板
# 用法：复制本文件为 server/.env 后按需填写。
# .env 已被 .gitignore 忽略，含密钥请勿入库。
# ============================================================

# ---- 运行环境 ----
# 生产环境设为 production：切紧凑日志格式（开发默认彩色详细日志）
NODE_ENV=production

# ---- 运行模式（核心开关）----
# standalone = 独立部署（不接任何中继，自己管自己）
# node       = 班级节点（从 relay 拉取额度，本地扣费）
# relay      = 中继权威节点（持有权威账本 + 管理台）
CLUSS_MODE=standalone

# ---- 服务端口 ----
# 全项目统一默认 9003（服务端默认端口、启动脚本与文档一致）
PORT=9003

# ---- 实例标识 ----
# 中继节点与班级节点都必须唯一，用于标识充值/扣费的来源
# 建议：relay 用 'relay'，班级节点用班级号如 'class-01'
CLUSS_INSTANCE_ID=cluss-local

# ---- JWT 配置（必须设置，否则服务无法启动）----
# 32 位以上随机字符串。与 ClassIntra 不同密钥是允许的（两者账号体系独立）
JWT_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ---- 数据库路径 ----
DB_PATH=./database/cluss.db

# ---- 管理员（仅 relay 模式使用）----
# 首次启动时若账号不存在则自动创建；存在则不改密码（避免重启覆盖）
ADMIN_USER_ID=999999
ADMIN_NET_NAME=管理员
ADMIN_REAL_NAME=Cluss管理员
ADMIN_PASSWORD=

# ---- 中继与节点通信（node / relay 模式使用）----
# RELAY_URL: 班级节点填写中继的 HTTP 地址（如 http://192.168.1.10:9003）
# SHARED_SECRET: 节点与中继之间的共享密钥，两端必须一致
CLUSS_RELAY_URL=
CLUSS_SHARED_SECRET=

# 额度快照拉取间隔（秒）
CLUSS_SYNC_INTERVAL=60
# 用量上报间隔（秒）
CLUSS_REPORT_INTERVAL=300
# 中继不可达时允许透支的容错金额（元）——防止「别班刚充值、本班没同步到」误拒
CLUSS_SYNC_TOLERANCE_YUAN=1

# ---- 积分换算率 ----
# 管理台与对账一律用「元」，学生端只显示「积分」——积分只是元的展示层，底层结算不变。
# 默认 1 元 = 100 积分（1 积分 = 1 分钱）：数量级够大、心算简单。
# 注意：改动会让学生看到的积分总额整体变化，建议只在学期初调整。
CLUSS_POINTS_PER_YUAN=100

# ---- 与 ClassIntra 联动（可选）----
# 填写后启用账号联邦：ClassIntra 用户可直接登录 Cluss
# CI_BRIDGE_URL: ClassIntra 的地址（如 http://192.168.1.10:9001）
# CI_BRIDGE_SECRET: 与 ClassIntra 的 RELAY_SECRET 一致
#
# ⚠️ CI_JWT_SECRET 是**对称共享密钥**，持有它的一方都能签出任意 token，
#   而 Cluss 会照 token 里的 is_admin 改写本地账号的管理身份 ——
#   所以它一旦泄露，等于 Cluss 的管理员权限泄露。
#   强烈建议改用 CI_JWT_PUBLIC_KEY（CI 用私钥签、Cluss 只持公钥）。
#
# CI_JWT_SECRET: 旧的共享密钥方式（填写后支持 token 互相免验直通）
#   ——仅用于迁移期，两条路径可并存，联登不会因切换而中断
# CI_JWT_PUBLIC_KEY: ClassIntra 的 RS256 **公钥**（PEM）。
#   推荐方式：CI 用私钥签 token，Cluss 只存公钥 —— 能验真，造不出假。
#   多行 PEM 在 .env 里要写成一行，用字面 \n 表示换行，例如：
#     CI_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkq...\n-----END PUBLIC KEY-----"
#
# 切换顺序（ClassIntra 侧已支持零配置自动生成密钥对，这边只需配公钥）：
#   1. 从 ClassIntra 拿到公钥：server/keys/jwt-public.pem
#      （ClassIntra 首次启动会自动生成这一对，无需手工创建）
#   2. 把公钥内容填到下面 CI_JWT_PUBLIC_KEY（单行，换行用字面 \n），重启
#   3. 联登已经走公钥；CI_JWT_SECRET 暂时留着 —— 它只用于验证
#      「还没来得及刷新的旧 HS256 token」（有效期 7 天）
#   4. 7 天后确认无人再持旧 token，把 CI_JWT_SECRET 清空，
#      验签就只剩公钥一条路径，此时共享密钥泄露也不再影响提权
#
# ⚠️ 第 4 步别急着做：清空后旧的 HS256 token 会立即全部失效，
#    等于把还没刷新的人一次性登出。
CI_BRIDGE_URL=
CI_BRIDGE_SECRET=
CI_JWT_SECRET=
CI_JWT_PUBLIC_KEY=

# ---- AI 模型种子（首次启动写入 ai_models 表，之后由管理台维护）----
AI_DEFAULT_MODEL_ID=deepseek-chat
AI_DEFAULT_API_URL=https://api.deepseek.com
AI_DEFAULT_API_KEY=
AI_DEFAULT_LABEL=DeepSeek Chat
# 单价单位：微元/千 token（1 元/百万 token = 1000 微元/千）
# 人民币 2 元/百万输入、8 元/百万输出 即 输入 2000、输出 8000
AI_DEFAULT_PRICE_IN=2000
AI_DEFAULT_PRICE_OUT=8000
AI_DEFAULT_PRICE_CACHE_HIT=200

# ---- 对外访问入口（生成分享链接用，可留空）----
PUBLIC_BASE_URL=

# ---- CORS（留空则仅同源）----
CORS_ORIGINS=