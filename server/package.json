{
  "name": "cluss-server",
  "version": "1.0.0",
  "private": true,
  "description": "Cluss 服务端（Express + SQLite + JWT）",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node src/app.js",
    "verify:points": "node scripts/verify-points.cjs",
    "verify:pricing": "node scripts/verify-pricing.cjs",
    "verify:credit-gate": "node scripts/verify-credit-gate.cjs",
    "verify:jwt": "node scripts/verify-jwt.js",
    "verify:turn": "node scripts/verify-turn-assembly.cjs",
    "verify:output": "node scripts/verify-output-experience.cjs",
    "verify:all": "node scripts/verify-points.cjs && node scripts/verify-pricing.cjs && node scripts/verify-credit-gate.cjs && node scripts/verify-jwt.js && node scripts/verify-turn-assembly.cjs && node scripts/verify-output-experience.cjs",
    "perf:gate": "node scripts/perf-gate.cjs",
    "perf:audit": "node scripts/perf-audit.cjs",
    "perf:stream": "node scripts/perf-stream.cjs",
    "perf:real-data": "node scripts/perf-real-data.cjs",
    "perf:nav": "node scripts/measure-nav-perf.cjs",
    "verify:touch": "node scripts/verify-touch-target.cjs",
    "audit:visual": "node scripts/audit-visual.cjs",
    "audit:sidebar": "node scripts/audit-sidebar-visual.cjs",
    "verify:notes": "node scripts/verify-notes-sidebar.cjs",
    "perf:cold": "node scripts/measure-cold-load.cjs",
    "perf:timeline": "node scripts/trace-timeline.cjs",
    "verify:katex": "node scripts/verify-katex-lazy.cjs",
    "verify:note-ref": "node scripts/verify-note-ref.cjs",
    "verify:no-blackout": "node scripts/verify-no-blackout.cjs"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5"
  }
}
